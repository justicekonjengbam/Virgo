ENVIRONMENT=development
DATABASE_URL=sqlite:///C:/absolute/path/to/cabApp/backend/cabapp.db
AUTO_MIGRATE=true
# Production example: postgresql+psycopg://cabapp:CHANGE_ME@localhost:5432/cabapp
JWT_SECRET_KEY=replace-with-a-long-random-secret
FIREBASE_CREDENTIALS_PATH=C:/secure/path/firebase-service-account.json
# Creates the first Admin account on backend startup. Never commit real credentials.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password
ADMIN_BOOTSTRAP_NAME=Virgo Operations Admin
ADMIN_BOOTSTRAP_ROLE=super_admin
GEOAPIFY_API_KEY=replace_with_your_geoapify_key
MAPS_CONTACT_EMAIL=studentdishant123@gmail.com

# Document Storage (AWS S3 / Cloudflare R2 / Local)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage/documents
LOCAL_STORAGE_ENCRYPTION_KEY=replace_with_secure_random_key_for_at_rest_encryption
# For S3 / R2:
S3_BUCKET_NAME=virgo-driver-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=replace_with_access_key
S3_SECRET_ACCESS_KEY=replace_with_secret_key
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
